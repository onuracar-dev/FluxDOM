      "code": "{\n  \"filename\": \"App.flow\",\n  \"script\": {\n    \"lang\": \"ts\",\n    \"content\": \"let items = ['compiler', 'signals'];\\n  let visible = true;\"\n  },\n  \"template\": {\n    \"childrenCount\": 1,\n    \"directives\": [\n      \"#if visible\",\n      \"#each items as item, index\"\n    ]\n  },\n  \"style\": {\n    \"scoped\": true,\n    \"content\": \"li { color: rebeccapurple; }\"\n  }\n}",
